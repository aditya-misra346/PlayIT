# Auralis Recognition Server Configuration
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
SESSION_SECRET=replace-with-32-byte-random-hex-in-production
DATA_DIR=./data

# Ordered recognition provider chain (acrcloud, audd, local)
RECOGNITION_PROVIDERS=acrcloud,audd,local
FALLBACK_ON_NO_MATCH=false

# Commercial Provider 1: ACRCloud (https://console.acrcloud.com)
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

# Commercial Provider 2: AudD (https://audd.io)
AUDD_API_TOKEN=

# Apple ShazamKit Developer Token Signing (for Android / Web / iOS clients)
APPLE_TEAM_ID=
SHAZAMKIT_KEY_ID=
SHAZAMKIT_PRIVATE_KEY=

# Local Acoustic Fingerprinting Catalog (Reference & Custom WAV tracks)
LOCAL_CATALOG_ENABLED=true
LOCAL_CATALOG_PATH=./data/local-catalog.json
LOCAL_MIN_SCORE=20

# Rate limits & cost controls
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=150
RATE_LIMIT_PER_DAY_ANON=60
DAILY_PROVIDER_BUDGET=5000
