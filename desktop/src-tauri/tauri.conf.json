{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auralis",
  "version": "1.2.0",
  "identifier": "app.auralis.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Auralis — Hear it. Know it.",
        "width": 1080,
        "height": 760,
        "minWidth": 380,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#060A14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "binaries/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "13.0"
    }
  }
}
