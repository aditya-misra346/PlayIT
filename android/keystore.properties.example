# Copy to keystore.properties (git-ignored) and fill in. Used by the `release` build type.
# Create an upload key with:
#   keytool -genkeypair -v -keystore auralis-upload.jks -alias auralis-upload \
#     -keyalg RSA -keysize 4096 -validity 10000
storeFile=../auralis-upload.jks
storePassword=CHANGE_ME
keyAlias=auralis-upload
keyPassword=CHANGE_ME
